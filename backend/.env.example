# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/myplatform

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# App URLs
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Selcom Payment Gateway
SELCOM_API_KEY=your_selcom_api_key
SELCOM_API_SECRET=your_selcom_api_secret
SELCOM_VENDOR_ID=your_selcom_vendor_id
SELCOM_BASE_URL=https://apigw.selcommobile.com/v1
# For testing use: https://apigw.selcommobile.com/test/v1

# Cloudinary (File Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379
